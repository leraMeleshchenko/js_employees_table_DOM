"use strict";
var tbody = document.querySelector("tbody");
var body = document.querySelector("body");
var arr = [
    "Name",
    "Position",
    "Age",
    "Salary"
];
var sortDirection = {};
// Функція сортування таблиці
document.addEventListener("click", function(ev) {
    if (ev.target.tagName === "TH") {
        var columnIndex = ev.target.cellIndex;
        var table = ev.target.closest("table");
        var tBody = table.querySelector("tbody");
        var rows = Array.from(tBody.rows);
        // eslint-disable-next-line max-len
        sortDirection[columnIndex] = !sortDirection[columnIndex];
        rows.sort(function(a, b) {
            var cellA = a.cells[columnIndex].textContent.trim();
            var cellB = b.cells[columnIndex].textContent.trim();
            if (columnIndex === 3) {
                cellA = parseFloat(cellA.replace(/[$,]/g, ""));
                cellB = parseFloat(cellB.replace(/[$,]/g, ""));
            }
            if (isNaN(cellA) || isNaN(cellB)) return sortDirection[columnIndex] ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
            else return sortDirection[columnIndex] ? cellA - cellB : cellB - cellA;
        });
        rows.forEach(function(row) {
            return tBody.appendChild(row);
        });
    }
});
// Виділення рядка
tbody.addEventListener("click", function(e) {
    // eslint-disable-next-line max-len
    document.querySelectorAll("tr").forEach(function(tr) {
        return tr.classList.remove("active");
    });
    e.target.closest("tr").classList.add("active");
});
// Додавання форми
var form = document.createElement("form");
form.classList.add("new-employee-form");
body.appendChild(form);
var label2 = document.createElement("label");
var select = document.createElement("select");
select.setAttribute("data-qa", "office");
select.setAttribute("required", true);
label2.textContent = "Office:";
label2.append(select);
arr.forEach(function(element) {
    var input = document.createElement("input");
    var label = document.createElement("label");
    label.textContent = "".concat(element, ":");
    input.setAttribute("data-qa", element.toLowerCase());
    input.setAttribute("required", true);
    if (element === "Age" || element === "Salary") input.type = "number";
    else input.type = "text";
    label.append(input);
    form.append(label);
});
form.append(label2);
var labels = form.querySelectorAll("label");
var lastLabel = labels[labels.length - 1];
var secondLabel = labels[1];
form.insertBefore(lastLabel, secondLabel.nextSibling);
[
    "Tokyo",
    "Singapore",
    "London",
    "New York",
    "Edinburgh",
    "San Francisco"
].forEach(function(el) {
    var option = document.createElement("option");
    option.textContent = el;
    option.setAttribute("value", el);
    select.appendChild(option);
});
var button = document.createElement("button");
button.textContent = "Save to table";
form.appendChild(button);
// Функція створення сповіщень
var pushNotification = function(title, description, type) {
    var element = document.createElement("div");
    element.classList.add("notification", type);
    element.setAttribute("data-qa", "notification");
    var h2 = document.createElement("h2");
    h2.textContent = title;
    h2.classList.add("title");
    var p = document.createElement("p");
    p.textContent = description;
    element.append(h2, p);
    body.appendChild(element);
    setTimeout(function() {
        element.remove();
    }, 2000);
};
// Відправка форми
button.addEventListener("click", function(e) {
    e.preventDefault();
    var name1 = form.querySelector('[data-qa="name"]').value.trim();
    var position = form.querySelector('[data-qa="position"]').value.trim();
    var office = select.value;
    var age = parseInt(form.querySelector('[data-qa="age"]').value.trim(), 10);
    var salary1 = form.querySelector('[data-qa="salary"]').value.trim();
    // Валідація полів
    if (name1.length < 4) {
        pushNotification("Error", "Name must be at least 4 characters.", "error");
        return;
    }
    if (isNaN(age) || age < 18 || age > 90) {
        pushNotification("Error", "Age must be between 18 and 90.", "error");
        return;
    }
    if (!name1 || !position || !office || isNaN(salary1)) {
        pushNotification("Error", "Please fill in all fields.", "error");
        return;
    }
    // Додавання нового рядка
    var newRow = document.createElement("tr");
    newRow.innerHTML = "\n    <td>".concat(name1, "</td>\n    <td>").concat(position, "</td>\n    <td>").concat(office, "</td>\n    <td>").concat(age, "</td>\n    <td>$").concat(salary1.toLocaleString(), "</td>\n  ");
    tbody.appendChild(newRow);
    form.reset();
    pushNotification("Success", "Employee added successfully!", "success");
});

